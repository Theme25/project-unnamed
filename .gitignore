# Keep arbitrary search outputs and local settings out of the repository root.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/Makefile
!/LICENSE*
!/src/
!/viewer/
!/tools/
!/docs/
!/LICENSES/

# Build products and local runtime data.
*.exe
*.o
*.obj
*.pyc
__pycache__/
*.parts/
smartforce-logs/
rbview.ini
rbview_states.txt
/viewer/tas_test
/tools/deathcause
/tools/framescan
/tools/trig_flip_search

# Test outputs belong in a disposable output directory.
/tools/test-output/
